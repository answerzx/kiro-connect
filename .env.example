# Copy this file to ~/.kiro-connect/.env or ./kiro-connect/.env.
# Never commit your real bot token or personal Telegram user id.

KIRO_CONNECT_TELEGRAM_TOKEN=

# Optional but strongly recommended. Use your Telegram numeric user id.
KIRO_CONNECT_ALLOWED_USERS=123456789

KIRO_CONNECT_KIRO_CLI=/path/to/kiro-cli
KIRO_CONNECT_WORK_DIR=/path/to/your/workspace
KIRO_CONNECT_MODEL=claude-opus-4.7

# Tool approval in a non-interactive Telegram environment.
# Set to 1 only if you want Kiro CLI to run all tools without asking.
KIRO_CONNECT_TRUST_ALL_TOOLS=0

KIRO_CONNECT_TIMEOUT_MS=900000
